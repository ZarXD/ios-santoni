+#if defined(SANTONI)
+	/*
+	 * Splash framebuffer: two 2MB Normal-NC blocks (0x90000000 - 0x90400000)
+	 * in the EXISTING V=P L2 table. Both framebuffer and RAM use L1 index 0.
+	 * In 4K mode, all bring-up RAM is below 4GB, so the first V=P L2 page is
