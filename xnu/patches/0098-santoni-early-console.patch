@@ -11,6 +11,26 @@
 #include <stdint.h>
 #include <kern/misc_protos.h>
 
+#if defined(SANTONI)
+static volatile uint8_t *early_fb = (volatile uint8_t *)(uintptr_t)0x90001000;
+#define EARLY_FB early_fb
+#define EARLY_W 720u
+#define EARLY_H 1280u
+#define EARLY_STRIDE 2160u
+#define EARLY_SCALE 2u
+#define EARLY_CELL_W (8u * EARLY_SCALE)
+#define EARLY_CELL_H (16u * EARLY_SCALE)
+#define EARLY_ROWS (EARLY_H / EARLY_CELL_H)
+#define EARLY_COLS (EARLY_W / EARLY_CELL_W)
+
+static inline void early_pixel24(unsigned int x, unsigned int y, uint32_t c) {
+	if (x >= EARLY_W || y >= EARLY_H) return;
+	volatile uint8_t *p = EARLY_FB + (y * EARLY_STRIDE) + (x * 3);
+	p[0] = (uint8_t)(c & 0xff);        // Blue
+	p[1] = (uint8_t)((c >> 8) & 0xff); // Green
+	p[2] = (uint8_t)((c >> 16) & 0xff);// Red
+}
+#else
 static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000;
 #define EARLY_FB early_fb
 #define EARLY_WIDTH 1080u
@@ -21,6 +41,7 @@
 #define EARLY_CELL_H (16u * EARLY_SCALE)
 #define EARLY_ROWS ((EARLY_HEIGHT - 32u) / EARLY_CELL_H)
 #define EARLY_COLS (EARLY_WIDTH / EARLY_CELL_W)
+#endif
 
 extern unsigned char iso_font[256 * 16];
 
@@ -31,12 +52,20 @@
 static void
 sweet_early_clear_row(void)
 {
+#if defined(SANTONI)
+	for (unsigned int y = 0; y < EARLY_CELL_H; y++) {
+		for (unsigned int x = 0; x < EARLY_W; x++) {
+			early_pixel24(x, early_row * EARLY_CELL_H + y, 0x00000000u);
+		}
+	}
+#else
 	for (unsigned int y = 0; y < EARLY_CELL_H; y++) {
 		volatile uint32_t *line = EARLY_FB + (early_row * EARLY_CELL_H + y) * EARLY_STRIDE;
 		for (unsigned int x = 0; x < EARLY_WIDTH; x++) {
 			line[x] = 0xff000000u;
 		}
 	}
+#endif
 }
 
 void
@@ -64,6 +93,15 @@
 	const unsigned char *glyph = iso_font + (unsigned char)c * 16;
 	for (unsigned int gy = 0; gy < 16; gy++) {
 		for (unsigned int sy = 0; sy < EARLY_SCALE; sy++) {
+#if defined(SANTONI)
+			unsigned int py = early_row * EARLY_CELL_H + gy * EARLY_SCALE + sy;
+			for (unsigned int gx = 0; gx < 8; gx++) {
+				uint32_t pixel = (glyph[gy] & (1u << gx)) ? 0x00ffffffu : 0x00000000u;
+				for (unsigned int sx = 0; sx < EARLY_SCALE; sx++) {
+					early_pixel24(early_col * EARLY_CELL_W + gx * EARLY_SCALE + sx, py, pixel);
+				}
+			}
+#else
 			volatile uint32_t *line = EARLY_FB +
 			    (early_row * EARLY_CELL_H + gy * EARLY_SCALE + sy) * EARLY_STRIDE +
 			    early_col * EARLY_CELL_W;
@@ -73,6 +111,7 @@
 					line[gx * EARLY_SCALE + sx] = pixel;
 				}
 			}
+#endif
 		}
 	}
 	early_col++;
@@ -93,11 +132,19 @@
 		return;
 	}
 	uint32_t color = 0xff00ff00u | ((stage & 7u) * 32u << 16);
+#if defined(SANTONI)
+	for (unsigned int y = (EARLY_H > 32 ? EARLY_H - 32 : 0); y < EARLY_H; y++) {
+		for (unsigned int x = stage * 48; x < (stage + 1) * 48; x++) {
+			early_pixel24(x, y, color);
+		}
+	}
+#else
 	for (unsigned int y = EARLY_HEIGHT - 32; y < EARLY_HEIGHT; y++) {
